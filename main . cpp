// Student login
void studentLogin()
{
    string id;
    string password;

    cout << "\n===== STUDENT LOGIN =====\n";

    cout << "Student ID: ";
    cin >> id;

    cout << "Password: ";
    cin >> password;

    int studentIndex = findStudent(id);

    if (studentIndex == -1 ||
        students[studentIndex].password != password)
    {
        cout << "Incorrect student ID or password.\n";
        return;
    }

    cout << "\nWelcome " << students[studentIndex].name << "!\n";

    int choice;

    do
    {
        cout << "\n===== STUDENT PORTAL =====\n";
        cout << "1. Register Unit\n";
        cout << "2. View Registered Units\n";
        cout << "3. View Marks\n";
        cout << "4. Access LMS\n";
        cout << "5. Logout\n";

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                registerUnit(studentIndex);
                break;

            case 2:
                viewUnits(studentIndex);
                break;

            case 3:
                viewMarks(studentIndex);
                break;

            case 4:
                studentLMS(studentIndex);
                break;

            case 5:
                cout << "Logging out...\n";
                break;

            default:
                cout << "Invalid choice.\n";
        }

    } while (choice != 5);
}


