#include <iostream>
#include <vector>
#include <string>

using namespace std;

struct Student
{
    string id;
    string name;
    string password;
    vector<string> units;
};

struct Lecturer
{
    string id;
    string name;
    string password;
    vector<string> units;
};

struct Staff
{
    string id;
    string name;
    string password;
};

struct Unit
{
    string code;
    string name;
    string lecturer;
};

struct Marks
{
    string studentId;
    string unitCode;
    int assignment;
    int cat;
    int exam;
};

vector<Student> students;
vector<Lecturer> lecturers;
vector<Staff> staff;
vector<Unit> units;
vector<Marks> marks;


// Find student
int findStudent(string id)
{
    for (int i = 0; i < students.size(); i++)
    {
        if (students[i].id == id)
            return i;
    }

    return -1;
}


// Find lecturer
int findLecturer(string id)
{
    for (int i = 0; i < lecturers.size(); i++)
    {
        if (lecturers[i].id == id)
            return i;
    }

    return -1;
}


// Find staff
int findStaff(string id)
{
    for (int i = 0; i < staff.size(); i++)
    {
        if (staff[i].id == id)
            return i;
    }

    return -1;
}


// Register unit
void registerUnit(int studentIndex)
{
    cout << "\nAvailable Units\n";
    cout << "1. CSC210 - Object Oriented Programming\n";
    cout << "2. SAD220 - Systems Analysis and Design\n";
    cout << "3. NET210 - Computer Networks\n";

    int choice;
    cout << "\nSelect unit: ";
    cin >> choice;

    string unitCode;

    if (choice == 1)
        unitCode = "CSC210";
    else if (choice == 2)
        unitCode = "SAD220";
    else if (choice == 3)
        unitCode = "NET210";
    else
    {
        cout << "Invalid choice.\n";
        return;
    }

    for (int i = 0; i < students[studentIndex].units.size(); i++)
    {
        if (students[studentIndex].units[i] == unitCode)
        {
            cout << "You have already registered this unit.\n";
            return;
        }
    }

    students[studentIndex].units.push_back(unitCode);

    cout << "Unit registered successfully.\n";
    cout << "The unit is now available on the LMS.\n";
}


// View registered units
void viewUnits(int studentIndex)
{
    cout << "\nYour Registered Units\n";

    if (students[studentIndex].units.size() == 0)
    {
        cout << "You have not registered any units.\n";
        return;
    }

    for (int i = 0; i < students[studentIndex].units.size(); i++)
    {
        cout << students[studentIndex].units[i] << endl;
    }
}


// View marks
void viewMarks(int studentIndex)
{
    bool found = false;

    cout << "\nYour Marks\n";

    for (int i = 0; i < marks.size(); i++)
    {
        if (marks[i].studentId == students[studentIndex].id)
        {
            found = true;

            int total = marks[i].assignment +
                        marks[i].cat +
                        marks[i].exam;

            cout << "\nUnit: " << marks[i].unitCode << endl;
            cout << "Assignment: " << marks[i].assignment << endl;
            cout << "CAT: " << marks[i].cat << endl;
            cout << "Exam: " << marks[i].exam << endl;
            cout << "Total: " << total << endl;

            if (total >= 70)
                cout << "Grade: A\n";
            else if (total >= 60)
                cout << "Grade: B\n";
            else if (total >= 50)
                cout << "Grade: C\n";
            else if (total >= 40)
                cout << "Grade: D\n";
            else
                cout << "Grade: E\n";
        }
    }

    if (!found)
        cout << "No marks have been entered yet.\n";
}


// Student LMS
void studentLMS(int studentIndex)
{
    int choice;

    do
    {
        cout << "\n===== LMS =====\n";
        cout << "1. View Registered Units\n";
        cout << "2. View Notes\n";
        cout << "3. View Assignments\n";
        cout << "4. View CATs\n";
        cout << "5. View Marks\n";
        cout << "6. Exit LMS\n";

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                viewUnits(studentIndex);
                break;

            case 2:
                cout << "\nNotes for your units are available here.\n";
                break;

            case 3:
                cout << "\nAssignments for your units are available here.\n";
                break;

            case 4:
                cout << "\nCATs for your units are available here.\n";
                break;

            case 5:
                viewMarks(studentIndex);
                break;

            case 6:
                cout << "Leaving LMS...\n";
                break;

            default:
                cout << "Invalid choice.\n";
        }

    } while (choice != 6);
}


// Lecturer enters marks
void enterMarks(int lecturerIndex)
{
    string unitCode;
    string studentId;

    cout << "\nEnter unit code: ";
    cin >> unitCode;

    bool teachesUnit = false;

    for (int i = 0; i < lecturers[lecturerIndex].units.size(); i++)
    {
        if (lecturers[lecturerIndex].units[i] == unitCode)
            teachesUnit = true;
    }

    if (!teachesUnit)
    {
        cout << "You are not assigned to this unit.\n";
        return;
    }

    cout << "Enter student ID: ";
    cin >> studentId;

    int studentIndex = findStudent(studentId);

    if (studentIndex == -1)
    {
        cout << "Student not found.\n";
        return;
    }

    Marks newMark;

    newMark.studentId = studentId;
    newMark.unitCode = unitCode;

    cout << "Enter assignment mark (out of 20): ";
    cin >> newMark.assignment;

    cout << "Enter CAT mark (out of 20): ";
    cin >> newMark.cat;

    cout << "Enter exam mark (out of 60): ";
    cin >> newMark.exam;

    if (newMark.assignment < 0 || newMark.assignment > 20 ||
        newMark.cat < 0 || newMark.cat > 20 ||
        newMark.exam < 0 || newMark.exam > 60)
    {
        cout << "Invalid marks entered.\n";
        return;
    }

    marks.push_back(newMark);

    cout << "\nMarks entered successfully.\n";
    cout << "The marks can now be viewed through the Student Portal.\n";
}


// Lecturer LMS
void lecturerLMS(int lecturerIndex)
{
    int choice;

    do
    {
        cout << "\n===== LECTURER LMS =====\n";
        cout << "1. View Units\n";
        cout << "2. Upload Notes\n";
        cout << "3. Create Assignment\n";
        cout << "4. Create CAT\n";
        cout << "5. Enter Marks\n";
        cout << "6. Logout\n";

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                cout << "\nYour Units:\n";

                for (int i = 0;
                     i < lecturers[lecturerIndex].units.size();
                     i++)
                {
                    cout << lecturers[lecturerIndex].units[i] << endl;
                }
                break;

            case 2:
                cout << "Notes uploaded successfully.\n";
                break;

            case 3:
                cout << "Assignment created successfully.\n";
                break;

            case 4:
                cout << "CAT created successfully.\n";
                break;

            case 5:
                enterMarks(lecturerIndex);
                break;

            case 6:
                cout << "Logging out...\n";
                break;

            default:
                cout << "Invalid choice.\n";
        }

    } while (choice != 6);
}


